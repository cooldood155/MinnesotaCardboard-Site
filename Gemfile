source "https://rubygems.org"

# Jekyll core and default aesthetic theme
gem "jekyll", "~> 4.3"
gem "minima", "~> 2.5"

# Jekyll plugins for SEO metadata and RSS feed automation
gem "jekyll-seo-tag"
gem "jekyll-feed"

# Time zone libraries (Jekyll requires tzinfo to handle localized dates/times)
gem "tzinfo", ">= 1", "< 3"

# Windows-specific:
# - tzinfo-data: Provides missing zoneinfo database
# - wdm: Monitors directory changes so `jekyll serve` can auto-reload
gem "tzinfo-data", platforms: [:windows]
gem "wdm", ">= 0.1.0", platforms: [:windows]
